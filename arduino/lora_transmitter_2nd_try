#include <SPI.h>
#include <RH_RF95.h>

#define RFM95_CS 10
#define RFM95_RST 9
#define RFM95_INT 2
#define RF95_FREQ 915.0 // Change to 433.0 if using a 433MHz module

RH_RF95 rf95(RFM95_CS, RFM95_INT);
unsigned long fib[20];

void setup() {
  Serial.begin(9600);
  pinMode(RFM95_RST, OUTPUT);
  digitalWrite(RFM95_RST, HIGH);

  // Manual reset
  digitalWrite(RFM95_RST, LOW);
  delay(10);
  digitalWrite(RFM95_RST, HIGH);
  delay(10);

  if (!rf95.init()) {
    Serial.println("LoRa radio init failed");
    while (1);
  }
  rf95.setFrequency(RF95_FREQ);
  rf95.setTxPower(23, false); 
  
  // Pre-calculate the first 20 Fibonacci numbers
  fib[0] = 0;
  fib[1] = 1;
  for (int i = 2; i < 20; i++) {
    fib[i] = fib[i - 1] + fib[i - 2];
  }
}

void loop() {
  for (int i = 0; i < 20; i++) {
    char radiopacket[20];
    itoa(fib[i], radiopacket, 10);
    
    Serial.print("Sending: ");
    Serial.println(radiopacket);
    
    rf95.send((uint8_t *)radiopacket, strlen(radiopacket) + 1);
    rf95.waitPacketSent();
    
    delay(1000); // 1-second delay between numbers
  }
  delay(3000); // 3-second delay before restarting the sequence
}
